# Copy to .env.production before: npm run build
APP_URL=https://nileschools.com
VITE_APP_URL=https://nileschools.com

# Dova Platform Copilot widget
DOVA_ENABLED=true
DOVA_DEMO_MODE=true

# Dova OpenAI response layer (rewrites knowledge — does not generate facts)
OPENAI_API_KEY=
DOVA_AI_ENABLED=true
DOVA_AI_MODEL=gpt-4o-mini
DOVA_AI_TEMPERATURE=0.3
DOVA_AI_MAX_TOKENS=1200

# Bilingual CMS auto-translation (OpenAI default)
TRANSLATION_AUTO_ENABLED=true
TRANSLATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
# DEEPL_API_KEY=
# GOOGLE_TRANSLATE_API_KEY=

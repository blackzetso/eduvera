          "host": [
            "wa",
            "semicolon-solution",
            "net"
          ],
          "path": [
            "send-message"
          ]
        },
        "description": "Send a WhatsApp message. Replace the jid with the target phone number in format: [country_code][number]@s.whatsapp.net"
      },
      "response": []
    },

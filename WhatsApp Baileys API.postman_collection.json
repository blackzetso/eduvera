    {
      "name": "Send WhatsApp Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"jid\": \"201234567890@s.whatsapp.net\",\n    \"text\": \"Hello from Baileys API!\"\n}"
        },
        "url": {
          "raw": "https://wa.semicolon-solution.net/send-message",
